---
import SiteHeader from "../components/SiteHeader.astro"
import SiteFooter from "../components/SiteFooter.astro"

const { name, description } = Astro.props

let pageTitle: string = `Arkansas Indie Books`
let pageDescription: string = "A list of indie books stores in Arkansas"

if (description) pageDescription = description

if (name) pageTitle = `${pageTitle} | ${name}`
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
	</head>
	<body>
		<SiteHeader />
		<main id="main-content">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
