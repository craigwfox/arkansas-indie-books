---
import SiteHeader from "../components/SiteHeader.astro"
import SiteFooter from "../components/SiteFooter.astro"
import "../sass/styles.scss"

const { name, description } = Astro.props

let pageTitle: string = `Arkansas Indie Books`
let pageDescription: string = "A list of indie books stores in Arkansas"

if (description) pageDescription = description

if (name) pageTitle = `${pageTitle} | ${name}`
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/images/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&display=swap"
			rel="stylesheet"
		/>
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-VKZJQ767HH"
		></script>
		<script>
			window.dataLayer = window.dataLayer || []

			function gtag(...args: any[]) {
				window.dataLayer.push(args)
			}

			gtag("js", new Date())
			gtag("config", "G-VKZJQ767HH")
		</script>
	</head>
	<body>
		<SiteHeader />
		<main id="main-content">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
