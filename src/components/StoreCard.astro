---
import { Buffer } from "node:buffer"
import type { InferEntrySchema, RenderedContent } from "astro:content"
import { undefined } from "astro:schema"

interface Props {
	store: InferEntrySchema<"stores">
	index: number
}

const { store, index } = Astro.props
const storeData = store
const storeIdClear = storeData.name.toLowerCase().replaceAll(" ", "-")
const storeId = Buffer.from(storeIdClear, "utf-8").toString("base64")
const storeAria = Buffer.from(`title-${storeIdClear}`, "utf-8").toString(
	"base64",
)

function classBase(element: string) {
	return `store-card__${element}`
}

function parentCardClass(): string {
	const variants = ["primary", "alt-one", "alt-two", "alt-three"]

	return `store-card store-card--${variants[index % variants.length]}`
}
---

<article id={storeId} aria-labelledby={storeAria} class={parentCardClass()}>
	<div class={classBase("spine")}>
		<span class={classBase("spine--binding")}></span>
		<span class={classBase("spine--text")}>{storeData.city}</span>
		<span class={classBase("spine--binding")}></span>
	</div>
	<div class={classBase("grid")}>
		<div class={classBase("content")}>
			<div class={classBase("content__header")}>
				<h2 id={storeAria} class={classBase("content__header__name")}>
					{storeData.name}
				</h2>
				<h3 class={classBase("content__header__address-title")}>Address</h3>
				<p class={classBase("content__header__address")}>
					{storeData.address}
					<br />
					{storeData.city}, AR
				</p>
				<table class={classBase("content__header__type")}>
					<tbody>
						<tr>
							<th scope="row">New</th>
							<td>
								{storeData.newBooks ? (
									<img
										src="/images/icon-checkbox-yes.svg"
										alt="has new books"
									/>
								) : (
									<img
										src="/images/icon-checkbox-no.svg"
										alt="does not have new books"
									/>
								)}
							</td>
						</tr>
						<tr>
							<th scope="row">Used</th>
							<td>
								{storeData.usedBooks ? (
									<img
										src="/images/icon-checkbox-yes.svg"
										alt="has used books"
									/>
								) : (
									<img
										src="/images/icon-checkbox-no.svg"
										alt="does not have used books"
									/>
								)}
							</td>
						</tr>
					</tbody>
				</table>
				{storeData.website && (
					<p class={classBase("content__header__url")}>
						<a
							href={storeData.website}
							target="_blank"
							rel="noreferrer nofollow"
						>
							Visit website
						</a>
					</p>
				)}
			</div>
			{storeData.image && (
				<img
					class={classBase("content__image")}
					src={`/store-images/${storeData.image}`}
					loading="lazy"
				/>
			)}
		</div>
		{store.rendered?.html && (
			<div class={classBase("description")}>
				<Fragment set:html={store.rendered.html} />
			</div>
		)}
	</div>
</article>
