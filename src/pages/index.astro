---
import Layout from "../layouts/Layout.astro"
import { getCollection } from "astro:content"
import StoreCard from "../components/StoreCard.astro"

const storeCollection = await getCollection("stores")
const stores = [...storeCollection].sort((a, b) =>
	a.data.city.localeCompare(b.data.city),
)
---

<Layout>
	<h1>Pizza</h1>
	{stores.map((store) => <StoreCard store={store} />)}
</Layout>
